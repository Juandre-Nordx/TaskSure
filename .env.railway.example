# Paste into Railway's web Variables > Raw Editor; replace the key and hostname.
# Replace Postgres in references if your existing database service has another name.
APP_NAME=TaskSure
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:REPLACE_WITH_YOUR_GENERATED_KEY
APP_URL=https://REPLACE_WITH_YOUR_WEB_DOMAIN
LOG_CHANNEL=stderr
DB_CONNECTION=pgsql
DB_HOST=${{Postgres.PGHOST}}
DB_PORT=${{Postgres.PGPORT}}
DB_DATABASE=${{Postgres.PGDATABASE}}
DB_USERNAME=${{Postgres.PGUSER}}
DB_PASSWORD=${{Postgres.PGPASSWORD}}
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
PROCESS_ROLE=web
PORT=8080
UPLOAD_STORAGE_PATH=/data/uploads
UPLOAD_MAX_KB=10240
REMINDER_MINUTES=60
TASK_EMAIL_ENABLED=false
MAIL_MAILER=log
MOBILE_ALLOWED_ORIGINS=capacitor://localhost,https://localhost
MOBILE_PUSH_ENABLED=false
# Add Firebase/APNs server credentials through Railway Variables; see docs/MOBILE.md.
