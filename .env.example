APP_NAME=TaskSure
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_ZA
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=tasksure
DB_USERNAME=tasksure
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
# Private path; mount Railway volume at /data and use /data/uploads in production.
UPLOAD_STORAGE_PATH=/data/uploads
UPLOAD_MAX_KB=10240
REMINDER_MINUTES=60
TASK_EMAIL_ENABLED=false
# log is a local diagnostic transport, not external delivery.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=tasksure@example.com
MAIL_FROM_NAME=TaskSure
# Supply these securely on Railway. Do not add DEMO_PASSWORD in production.
